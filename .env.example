# ============================================================
# INSEE SIRENE API — required (choose Option A or B)
# Portal: https://portail-api.insee.fr
# ============================================================

# Option A (easiest) — create a "Simple" application
# Gives you one API key. Paste it here:
SIRENE_API_KEY=

# Option B — create a "Machine-to-machine" application
# Gives you client_id + client_secret. Paste both here:
SIRENE_CLIENT_ID=
SIRENE_CLIENT_SECRET=

# ============================================================
# INPI RNE API — optional (for actual turnover data)
# Register free at https://data.inpi.fr
# Without these, turnover falls back to employee band estimates.
# ============================================================
INPI_USERNAME=
INPI_PASSWORD=
