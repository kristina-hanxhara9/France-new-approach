# INSEE SIRENE API — required
# Get your token: https://api.insee.fr → create app → generate Bearer token
# Token expires every ~7 days, regenerate with:
#   curl -X POST https://api.insee.fr/token \
#     -H "Content-Type: application/x-www-form-urlencoded" \
#     -d "grant_type=client_credentials" \
#     -u "YOUR_CONSUMER_KEY:YOUR_CONSUMER_SECRET"
SIRENE_BEARER_TOKEN=

# INPI RNE API — optional (for actual turnover data)
# Register free at https://data.inpi.fr → profile → "Mes accès API / SFTP"
# Without these, turnover falls back to employee band estimates.
INPI_USERNAME=
INPI_PASSWORD=
