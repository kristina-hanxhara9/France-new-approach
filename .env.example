# INSEE SIRENE API — required
# 1. Go to https://portail-api.insee.fr
# 2. Create a free account
# 3. Subscribe to the API Sirene
# 4. Copy the API key from your application page
SIRENE_API_KEY=

# INPI RNE API — optional (for actual turnover data)
# Register free at https://data.inpi.fr → profile → "Mes accès API / SFTP"
# Without these, turnover falls back to employee band estimates.
INPI_USERNAME=
INPI_PASSWORD=
